PS5_HOST ?= ps5
PS5_PORT ?= 9020

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK is undefined)
endif

PLATFORM := ps5
ELF := build/ps5/elfldr-ps5.elf
LIB := build/ps5/lib-elfldr.a

CFLAGS := -Wall -Werror -O1
LDADD  := -lSceSsl -lSceHttp

include Makefile.build

all: $(ELF) $(LIB)

$(OBJ_DIR)/elfldr.o: source/ps5/elfldr.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/elfldr_shared.o: source/shared/elfldr.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@


$(LIB): $(addprefix $(OBJ_DIR)/,elfldr.o elfldr_shared.o mem.o)
	@mkdir -p $(BUILD_DIR)
	$(AR) rcs $@ $^

$(OBJ_DIR)/bootstrap.o: source/ps5/bootstrap.c $(OBJ_DIR)/socksrv.elf
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/main.o: source/ps5/main.c $(OBJ_DIR)/bootstrap.elf
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/bootstrap.elf: $(addprefix $(OBJ_DIR)/,bootstrap.o elfldr.o elfldr_shared.o mem.o notify.o) $(PTRACE)
	$(CC) -o $@ $^
	$(STRIP) $@

$(OBJ_DIR)/socksrv.elf: $(addprefix $(OBJ_DIR)/,socksrv.o selfldr.o elfldr.o elfldr_shared.o mem.o notify.o uri.o) $(PTRACE)
	$(CC) -o $@ $^ $(LDADD)
	$(STRIP) $@

$(ELF): $(addprefix $(OBJ_DIR)/,main.o elfldr.o elfldr_shared.o mem.o notify.o) $(PTRACE)
	$(CC) -o $@ $^
	$(STRIP) $@

test: $(ELF)
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $^

.INTERMEDIATE: $(OBJ_DIR)/socksrv.elf $(OBJ_DIR)/bootstrap.elf
